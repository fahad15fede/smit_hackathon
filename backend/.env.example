# development | production
ENVIRONMENT=development

# Supabase -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase -> Project Settings -> API Keys -> Secret keys (sb_secret_...).
# Legacy projects: the service_role key. Never use the publishable/anon key here,
# and never expose this key to the browser.
SUPABASE_SECRET_KEY=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_HOURS=8

# Comma-separated list of frontend origins allowed by CORS.
FRONTEND_ORIGIN=http://localhost:5173

# AI assistant: Groq (https://console.groq.com/keys). Backend-only: the browser never sees it.
# Without a key the assistant shows a friendly fallback. The model must support tool calling.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
